{
  "expo": {
    "name": "새록",
    "slug": "saerok-android-v2",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FEFEFE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./path/to/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.apu.saerok"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d00623fb800a685c8068878ee9ef7ef7"
        }
      ],
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "${EXPO_PUBLIC_NAVER_MAP_CLIENT_ID}"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "새록 이미지를 저장하기 위해 사진 접근 권한이 필요해요.",
          "savePhotosPermission": "새록 이미지를 갤러리에 저장하기 위해 권한이 필요해요."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9beb5a2-2d3e-47dd-a576-3666eda927e3"
      }
    }
  }
}
